# --- Secrets: real DB credentials live here, never commit ---
api/config.local.php
config.local.php
*.local.php
.env
.env.*

# --- Dev diagnostics: print DB host/user/port and password length ---
_diag.php
_diag.txt

# --- Build/deploy artifacts ---
index.zip
*.zip
*.tar.gz

# --- Runtime caches ---
tmp/
.cache/

# --- Node ---
node_modules/

# --- Supabase CLI local state ---
supabase/.temp/

# --- Logs ---
*.log

# --- Student uploads are runtime data, not source ---
# Keep the folder itself in git so a fresh clone has a place to write.
assets/uploads/students/*
!assets/uploads/students/.gitkeep

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
